{
  "name": "engagingnetworks-mcp",
  "version": "0.1.0",
  "description": "MCP server for Engaging Networks: lets Claude, ChatGPT and other MCP clients read campaign pages, supporters, their transaction history and recurring schedules, supporter fields and questions, and marketing automation stats, and (when enabled) update a supporter's opt-ins.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node test/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "engagingnetworks",
    "claude",
    "nonprofit-fundraising"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "engagingnetworks-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
